# Example provider selections. Use scripts/configure_flower.py for private key
# entry and mode-600 storage; preserve any existing .env. Never commit a key.
# See README "Switching models".

# --- ACTIVE default: Nebius Token Factory (fast, event key) ---
FLWR_MODEL_API_ENDPOINT=https://api.tokenfactory.tf-ca1.nebius.com/v1/responses
FLWR_MODEL_API_KEY=
# Event key shared privately in team chat. Never commit it.
INVESTIGATOR_MODEL=dedicated/flowerai/MiniMax-M3-OOLI9o
# Alt Nebius model (own key): dedicated/flowerai/Kimi-K2.7-Code-1OUHWL

# --- FALLBACK: Endeavor via Flower's gateway (challenge bonus model) ---
# FLWR_MODEL_API_ENDPOINT=
# blank endpoint above = Flower's own gateway (https://api.flower.ai/v1/responses)
# FLWR_MODEL_API_KEY=
# Your Flower key: flower.ai -> Profile -> Settings -> API Keys. Never commit it.
# INVESTIGATOR_MODEL=flwrlabs/endeavor-1.0

